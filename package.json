{
  "name": "nexusai-bridge",
  "version": "1.0.0",
  "description": "NexusAI Bridge - local HTTP/MCP bridge between AI tooling and Roblox Studio with per-session dynamic tokens",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "nexusai-bridge": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js --log-level debug",
    "test": "node --test tests/*.test.js",
    "print-config": "node src/index.js --print-config"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "roblox",
    "roblox-studio",
    "bridge",
    "mcp",
    "nexusai",
    "luau"
  ],
  "license": "MIT",
  "private": true,
  "dependencies": {}
}
