{
  "name": "arena-studio-connecter",
  "version": "2.0.0",
  "description": "Arena Studio Connecter - sichere Desktop-Bridge zwischen Arena Agent und Roblox Studio",
  "type": "module",
  "main": "desktop/main.js",
  "bin": {
    "arena-studio-connecter": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js --log-level debug",
    "desktop": "electron .",
    "test": "node --test tests/*.test.js",
    "print-config": "node src/index.js --print-config",
    "prepare:cloudflared": "node scripts/download-cloudflared.mjs",
    "dist:win": "npm run prepare:cloudflared && electron-builder --win nsis portable --x64",
    "dist:portable": "npm run prepare:cloudflared && electron-builder --win portable --x64",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "dist:standalone": "node scripts/build-standalone.mjs",
    "dist:download": "npm run dist:standalone && node scripts/build-download-exe.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "arena",
    "roblox",
    "roblox-studio",
    "bridge",
    "mcp",
    "luau"
  ],
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ai.arena.studio.connecter",
    "productName": "Arena Studio Connecter",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "desktop/assets"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "public/**/*",
      "roblox/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/cloudflared-windows-amd64.exe",
        "to": "cloudflared.exe"
      }
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Arena-Studio-Connecter-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Arena Studio Connecter",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Arena-Studio-Connecter-Portable-${version}-${arch}.${ext}"
    }
  }
}
